# Enhanced Activity Monitor - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# =============================================================================
# MQTT Configuration (Required)
# =============================================================================
EAM_MQTT_BROKER=localhost
EAM_MQTT_PORT=8883
EAM_MQTT_USERNAME=eam_client
EAM_MQTT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# TLS Certificates (for production)
EAM_MQTT_CA_CERT=certs/ca.crt
EAM_MQTT_CLIENT_CERT=certs/client.crt
EAM_MQTT_CLIENT_KEY=certs/client.key

# =============================================================================
# Database Encryption (Required)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EAM_DB_ENCRYPTION_KEY=CHANGE_ME_GENERATE_NEW_KEY

# =============================================================================
# Authentication (Required)
# =============================================================================
# Generate password hash with:
# python -c "from security.secure_config import SecureCredentialManager; print(SecureCredentialManager.hash_password('your_password'))"
EAM_ADMIN_PASSWORD_HASH=CHANGE_ME_HASH_YOUR_PASSWORD
EAM_ADMIN_PASSWORD_SALT=CHANGE_ME_SALT_FROM_HASH_FUNCTION

# =============================================================================
# Optional: Face Recognition Storage
# =============================================================================
EAM_FACE_ENCRYPTION_KEY=CHANGE_ME_GENERATE_NEW_KEY

# =============================================================================
# Optional: API Keys (for integrations)
# =============================================================================
# EAM_API_KEY=CHANGE_ME_GENERATE_API_KEY
# EAM_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# =============================================================================
# Optional: Monitoring & Logging
# =============================================================================
EAM_LOG_LEVEL=INFO
EAM_AUDIT_LOG_PATH=logs/audit.log
EAM_ENV_FILE=.env

# =============================================================================
# Development Only (NEVER use in production)
# =============================================================================
# EAM_DEV_MODE=true
# EAM_SKIP_TLS_VERIFY=false
