# Enhanced Activity Monitor - Docker Compose Environment
# Copy this file to .env and update the values

# Database
POSTGRES_PASSWORD=your-secure-postgres-password

# Redis
REDIS_PASSWORD=your-secure-redis-password

# API Security
SECRET_KEY=your-secure-secret-key-at-least-32-characters

# Grafana
GRAFANA_PASSWORD=your-secure-grafana-password

# EMQX MQTT Broker
MQTT_USERNAME=eam
MQTT_PASSWORD=your-secure-mqtt-password
EMQX_DASHBOARD_PASSWORD=your-secure-emqx-dashboard-password

# Flink MQTT credentials (separate user for Flink consumers)
FLINK_MQTT_PASSWORD=your-secure-flink-mqtt-password

# Nurse Call System API (optional — leave empty to disable)
NURSE_CALL_API=

# SSL Certificates (paths relative to deploy directory)
SSL_CERT_PATH=./nginx/ssl/server.crt
SSL_KEY_PATH=./nginx/ssl/server.key
